// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles in the platform
enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  USER
}

// User verification status for registration approval flow
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Organization status
enum OrgStatus {
  ACTIVE
  PENDING_SETUP
  SUSPENDED
}

// Fuel type options for registered vehicles
enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

// Vehicle verification status
enum VehicleStatus {
  VERIFIED
  PENDING
  REJECTED
}

// Ride status lifecycle
enum RideStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

// Ride join request status
enum JoinRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

// Who initiated the join request
enum InitiatedBy {
  PASSENGER
  DRIVER
}

// Trip status
enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Payment method options
enum PaymentMethod {
  WALLET
  CASH
  CARD
  UPI
}

// Payment status
enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// Negotiation lifecycle status
enum NegotiationStatus {
  OPEN
  ACCEPTED
  REJECTED
}

// Which side submitted a negotiation offer
enum OfferSide {
  PASSENGER
  DRIVER
}

model Org {
  id                    String    @id @default(uuid())
  name                  String
  slug                  String?   @unique
  status                OrgStatus @default(ACTIVE)
  subsidyPercent        Float     @default(0.0)
  baseRideCharge        Float     @default(0.0)
  maxRidersPerCarpool   Int       @default(4)
  autoMatchEnabled      Boolean   @default(true)
  departmentRestriction Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  users User[]
  rides Ride[]
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  employeeId         String?
  role               Role               @default(USER)
  verificationStatus VerificationStatus @default(PENDING)
  rejectionReason    String?
  idProofPath        String?
  idProofUploadedAt  DateTime?
  carpoolAccess      Boolean            @default(true)
  rating             Float?             @default(5.0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id])

  vehicles               Vehicle[]
  drivenRides            Ride[]               @relation("DriverRides")
  joinRequests           JoinRequest[]        @relation("PassengerJoinRequests")
  negotiationsAsPass     Negotiation[]        @relation("PassengerNegotiations")
  bookings               Booking[]            @relation("PassengerBookings")
  driverTrips            Trip[]               @relation("DriverTrips")
  passengerTrips         TripPassenger[]
  sentMessages           Message[]
  wallet                 Wallet?
  savedPlaces            SavedPlace[]
  callLogsAsCaller       CallLog[]            @relation("CallerLogs")
  callLogsAsReceiver     CallLog[]            @relation("ReceiverLogs")
  walletTransactionLocks WalletTransaction[]  @relation("TransactionLockedBy")

  @@index([orgId])
  @@index([email])
}

model Vehicle {
  id                 String        @id @default(uuid())
  model              String
  registrationNumber String
  seatingCapacity    Int
  fuelType           FuelType      @default(PETROL)
  status             VehicleStatus @default(PENDING)
  licensePath        String?
  rejectionReason    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  rides Ride[]

  @@index([ownerId])
}

model Ride {
  id                   String     @id @default(uuid())
  pickupLabel          String
  pickupLat            Float
  pickupLng            Float
  destinationLabel     String
  destinationLat       Float
  destinationLng       Float
  departureAt          DateTime
  availableSeats       Int
  farePerSeat          Decimal    @db.Decimal(10, 2)
  status               RideStatus @default(SCHEDULED)
  routeDistanceKm      Float?
  routeDurationMinutes Float?
  routeGeometry        String?    @db.Text
  isRecurring          Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  driverId String
  driver   User   @relation("DriverRides", fields: [driverId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  joinRequests JoinRequest[]
  negotiations Negotiation[]
  bookings     Booking[]
  trip         Trip?

  @@index([driverId])
  @@index([orgId])
  @@index([status])
}

model JoinRequest {
  id             String            @id @default(uuid())
  initiatedBy    InitiatedBy       @default(PASSENGER)
  agreedFare     Decimal           @db.Decimal(10, 2)
  seatsRequested Int               @default(1)
  status         JoinRequestStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  rideId String
  ride   Ride   @relation(fields: [rideId], references: [id])

  passengerId String
  passenger   User   @relation("PassengerJoinRequests", fields: [passengerId], references: [id])

  negotiations Negotiation[]
  booking      Booking?

  @@index([rideId])
  @@index([passengerId])
}

model Negotiation {
  id        String            @id @default(uuid())
  status    NegotiationStatus @default(OPEN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  rideId String
  ride   Ride   @relation(fields: [rideId], references: [id])

  passengerId String
  passenger   User   @relation("PassengerNegotiations", fields: [passengerId], references: [id])

  requestId String?
  request   JoinRequest? @relation(fields: [requestId], references: [id])

  offers NegotiationOffer[]

  @@index([rideId])
  @@index([passengerId])
}

model NegotiationOffer {
  id        String    @id @default(uuid())
  offeredBy OfferSide
  amount    Decimal   @db.Decimal(10, 2)
  createdAt DateTime  @default(now())

  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id])

  @@index([negotiationId])
}

model Booking {
  id          String   @id @default(uuid())
  seatsBooked Int      @default(1)
  totalFare   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  requestId String      @unique
  request   JoinRequest @relation(fields: [requestId], references: [id])

  rideId String
  ride   Ride   @relation(fields: [rideId], references: [id])

  passengerId String
  passenger   User   @relation("PassengerBookings", fields: [passengerId], references: [id])

  payment Payment?

  @@index([rideId])
  @@index([passengerId])
}

model Trip {
  id                   String     @id @default(uuid())
  status               TripStatus @default(SCHEDULED)
  startedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  routeGeometry        String?    @db.Text
  routeDistanceKm      Float?
  routeDurationMinutes Float?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  rideId String @unique
  ride   Ride   @relation(fields: [rideId], references: [id])

  driverId String
  driver   User   @relation("DriverTrips", fields: [driverId], references: [id])

  passengers    TripPassenger[]
  locations     TripLocation[]
  messages      Message[]
  callLogs      CallLog[]
  payments      Payment[]
  fareBreakdown FareBreakdown?

  @@index([driverId])
  @@index([status])
}

model TripPassenger {
  id            String        @id @default(uuid())
  seatsBooked   Int           @default(1)
  fareAmount    Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id])

  passengerId String
  passenger   User   @relation(fields: [passengerId], references: [id])

  @@unique([tripId, passengerId])
  @@index([tripId])
  @@index([passengerId])
}

model TripLocation {
  id         String   @id @default(uuid())
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id])

  @@index([tripId])
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id])

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  @@index([tripId])
}

model CallLog {
  id          String    @id @default(uuid())
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int?

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id])

  callerId String
  caller   User   @relation("CallerLogs", fields: [callerId], references: [id])

  receiverId String
  receiver   User   @relation("ReceiverLogs", fields: [receiverId], references: [id])

  @@index([tripId])
}

model Payment {
  id                      String        @id @default(uuid())
  amount                  Decimal       @db.Decimal(10, 2)
  method                  PaymentMethod @default(WALLET)
  status                  PaymentStatus @default(PENDING)
  razorpayOrderId         String?
  razorpayPaymentId       String?
  razorpaySignature       String?
  transactionIdIdempotent String?       @unique
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id])

  walletTransaction WalletTransaction?

  @@index([status])
}

model Wallet {
  id        String   @id @default(uuid())
  balance   Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  transactions WalletTransaction[]
}

model WalletTransaction {
  id             String   @id @default(uuid())
  type           String // CREDIT or DEBIT
  amount         Decimal  @db.Decimal(10, 2)
  description    String
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  lockedById String?
  lockedBy   User?   @relation("TransactionLockedBy", fields: [lockedById], references: [id])

  @@index([walletId])
}

model SavedPlace {
  id        String   @id @default(uuid())
  label     String // e.g. Home, Work
  address   String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
}

model FareBreakdown {
  id            String  @id @default(uuid())
  distanceKm    Float
  durationMin   Float
  fuelComponent Decimal @db.Decimal(10, 2)
  baseFee       Decimal @db.Decimal(10, 2)
  orgSubsidy    Decimal @db.Decimal(10, 2)
  finalPerRider Decimal @db.Decimal(10, 2)

  tripId String @unique
  trip   Trip   @relation(fields: [tripId], references: [id])
}
