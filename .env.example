# Application Configuration
PORT=3000
NODE_ENV=development

# Database Connection (Local Docker Postgres on port 5433 by default)
DATABASE_URL="postgresql://carpool_user:carpool_pass@localhost:5433/carpool_db?schema=public"

# Database Docker Setup Variables
POSTGRES_USER=carpool_user
POSTGRES_PASSWORD=carpool_pass
POSTGRES_DB=carpool_db
POSTGRES_PORT=5433

# JWT Security
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-prod"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-prod"
JWT_PENDING_SECRET="super-secret-pending-token-key-change-in-prod"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# OSRM Routing Engine Base URL
OSRM_BASE_URL="https://router.project-osrm.org"

# Razorpay Payments Configuration
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"
